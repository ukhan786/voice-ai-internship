# ─────────────────────────────────────────────────────────────────────────
# Westside Lexus Voice AI — Intern Journey
#
# This is a local-first SQLite app: NO environment variables are required.
# Just `npm install && npm run dev`. Copy this file to `.env.local` only if
# you want to override one of the optional settings below.
# ─────────────────────────────────────────────────────────────────────────

# Optional: where the SQLite database file lives (default: ./data/app.db)
# SQLITE_PATH=/absolute/path/to/app.db

# Optional: show the in-nav "view as intern/manager" toggle (default: true)
# NEXT_PUBLIC_ENABLE_DEMO_TOGGLE=true
